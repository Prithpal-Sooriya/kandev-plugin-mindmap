{
  "name": "kandev-plugin-mindmap",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle:ui": "esbuild ui/src/register.tsx --bundle --format=esm --target=es2022 --jsx=transform --jsx-factory=h --jsx-fragment=Fragment --outfile=ui/bundle.js --legal-comments=none",
    "build:ui": "npm run typecheck && npm run bundle:ui",
    "test:ui": "vitest run tests",
    "sync:tools": "node scripts/sync-manifest-tools.mjs",
    "check:tools": "node scripts/sync-manifest-tools.mjs --check"
  },
  "devDependencies": {
    "@kandev/plugin-sdk": "file:../kandev-sdk/apps/packages/plugin-sdk",
    "@types/node": "^24.19.2",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "nanoid": "5.1.16",
    "vite": "8.3.4"
  }
}
