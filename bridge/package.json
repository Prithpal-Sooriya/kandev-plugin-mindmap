{
  "name": "kandev-mindmap-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent bridge for the Kandev mind map plugin: a stdio MCP server and a Pi extension over /agent/v1/tools.",
  "bin": {
    "kandev-mindmap-mcp": "./dist/kandev-mindmap-mcp.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "live": "node scripts/live-test.mjs",
    "sync:prompt": "node scripts/sync-prompt.mjs",
    "check:prompt": "node scripts/sync-prompt.mjs --check"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@types/node": "^24.19.2",
    "esbuild": "0.25.10",
    "typebox": "^1.3.27",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
