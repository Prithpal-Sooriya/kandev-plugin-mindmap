{
  "name": "spawn",
  "description": "Start sub-agents on nodes, each as its own Kandev task, so a branch can grow its own research team. Use it when a branch needs deep or parallel work you should not do yourself. Each agent needs a node and a concrete goal. Sub-agents share your run's budget: each one counts against max_subagents and their nodes count against max_nodes. Returns the new run ids; you do not need to wait for them.",
  "annotations": {
    "read_only_hint": false,
    "destructive_hint": false,
    "idempotent_hint": false,
    "open_world_hint": true
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agents": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "description": "One entry per sub-agent.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "goal"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "maxLength": 64,
              "description": "Where the sub-agent works. Node id (nd_...) or an @ref you set earlier in this run."
            },
            "goal": {
              "type": "string",
              "maxLength": 2000,
              "description": "What it should achieve, concretely."
            },
            "template": {
              "type": "string",
              "enum": [
                "research",
                "explore",
                "swarm",
                "critique"
              ],
              "description": "Default research."
            },
            "lens": {
              "type": "string",
              "enum": [
                "researcher",
                "skeptic",
                "builder",
                "contrarian",
                "examples_hunter",
                "futurist"
              ],
              "description": "Persona, mainly for swarm."
            },
            "profile": {
              "type": "string",
              "maxLength": 100,
              "description": "Agent profile name or id. Default: same as yours."
            },
            "mode": {
              "type": "string",
              "enum": [
                "apply",
                "propose"
              ],
              "description": "Default: your mode."
            },
            "budget": {
              "type": "object",
              "additionalProperties": false,
              "description": "Caps for this sub-agent, within what you have left.",
              "properties": {
                "max_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "max_nodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "max_subagents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "max_minutes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 240
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "agents"
    ]
  }
}
